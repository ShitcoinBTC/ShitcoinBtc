# ShitcoinBtc explorer configuration.
# Copied to /opt/shitcoin-explorer/.env by install-explorer.sh
# (the installer rewrites BTCEXP_BITCOIND_COOKIE for the node user).
# Full option reference: https://github.com/janoside/btc-rpc-explorer/blob/master/.env-sample

# App bind — localhost only. Public access goes through a reverse proxy.
BTCEXP_HOST=127.0.0.1
BTCEXP_PORT=3002

# ShitcoinBtc daemon RPC (mainnet RPC port 8370, see src/chainparamsbase.cpp).
BTCEXP_BITCOIND_HOST=127.0.0.1
BTCEXP_BITCOIND_PORT=8370

# Cookie auth (default): syscoind writes ~/.syscoin/.cookie on startup.
# The explorer must run as the same OS user as syscoind for this to work.
# Alternative: comment the cookie line out and set USER/PASS to match
# rpcuser=/rpcpassword= in syscoin.conf.
BTCEXP_BITCOIND_COOKIE=/home/shitcoin/.syscoin/.cookie
#BTCEXP_BITCOIND_USER=
#BTCEXP_BITCOIND_PASS=

# No exchange-rate lookups (SHIT has no price feeds) and no IP-geolocation.
BTCEXP_NO_RATES=true
BTCEXP_PRIVACY_MODE=true

# Dark theme; keep resource-intensive features off on a shared VPS.
BTCEXP_UI_THEME=dark
BTCEXP_SLOW_DEVICE_MODE=true

# Optional: gate the site behind a password (any username, password checked).
#BTCEXP_BASIC_AUTH_PASSWORD=change-me

# Optional: full address transaction history needs an Electrum-protocol
# server (phase 2 — an ElectRS fork patched with ShitcoinBtc's genesis).
#BTCEXP_ADDRESS_API=electrum
#BTCEXP_ELECTRUM_SERVERS=tcp://127.0.0.1:50001
