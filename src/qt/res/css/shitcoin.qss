/* Shitcoin - dark theme, Bitcoin-orange (#F7931A) primary accent
   sampled from the brand coin logo. Works together with the dark
   QPalette set in GuiMain (which also drives PlatformStyle::SingleColor()
   so toolbar icons recolor bitcoin-orange). */

/* ---------- main surfaces ---------- */
QMainWindow, QDialog {
    background-color: #141414;
}
QTabWidget::pane {
    border: 1px solid #2c2c2c;
    background-color: #161616;
    border-radius: 6px;
}
QTabBar::tab {
    background-color: #1f1f1f;
    color: #bdbdbd;
    padding: 9px 18px;
    margin-right: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background-color: #F7931A;
    color: #141414;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #2c2c2c;
    color: #F7931A;
}

/* ---------- toolbar / menus ---------- */
QToolBar {
    background-color: #101010;
    border: none;
    spacing: 8px;
    padding: 6px;
}
QToolButton {
    background-color: transparent;
    color: #e8e8e8;
    border: none;
    border-radius: 10px;
    padding: 10px;
}
QToolButton:hover {
    background-color: #262626;
}
QToolButton:checked, QToolButton:pressed {
    background-color: #F7931A;
    color: #141414;
}
QMenuBar {
    background-color: #101010;
    color: #e8e8e8;
}
QMenuBar::item:selected {
    background-color: #2a2a2a;
    color: #F7931A;
}
QMenu {
    background-color: #1e1e1e;
    color: #e8e8e8;
    border: 1px solid #333333;
    padding: 4px;
}
QMenu::item:selected {
    background-color: #F7931A;
    color: #141414;
}
QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 8px;
}

/* ---------- buttons ---------- */
QPushButton {
    background-color: #F7931A;
    color: #141414;
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #FFA940;
}
QPushButton:pressed {
    background-color: #D67E14;
}
QPushButton:disabled {
    background-color: #333333;
    color: #777777;
}
QPushButton[flat="true"] {
    background-color: transparent;
    color: #F7931A;
}
QPushButton[flat="true"]:hover {
    background-color: #262626;
}

/* ---------- status indicator buttons (out-of-sync warning icons) ---------- */
/* Icon-only QPushButtons: keep transparent so the warning icon itself shows
   instead of a solid orange square. */
QPushButton#labelWalletStatus, QPushButton#labelTransactionsStatus {
    background-color: transparent;
    border: none;
    padding: 4px;
}
QPushButton#labelWalletStatus:hover, QPushButton#labelTransactionsStatus:hover {
    background-color: #262626;
}
QPushButton#labelWalletStatus:pressed, QPushButton#labelTransactionsStatus:pressed {
    background-color: #1a1a1a;
}

/* ---------- inputs ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit {
    background-color: #0d0d0d;
    color: #e8e8e8;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 7px;
    selection-background-color: #F7931A;
    selection-color: #141414;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #F7931A;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: #e8e8e8;
    selection-background-color: #F7931A;
    selection-color: #141414;
    border: 1px solid #3a3a3a;
}

/* ---------- tables / lists / trees ---------- */
QTableView, QTreeView, QListView {
    background-color: #161616;
    alternate-background-color: #1b1b1b;
    color: #e8e8e8;
    border: 1px solid #2c2c2c;
    border-radius: 6px;
    gridline-color: #262626;
    selection-background-color: #F7931A;
    selection-color: #141414;
    outline: none;
}
QTableView::item, QTreeView::item, QListView::item {
    padding: 5px;
}
QHeaderView::section {
    background-color: #222222;
    color: #F7931A;
    border: none;
    padding: 8px;
    font-weight: bold;
}
QTreeView::branch {
    background-color: #161616;
}

/* ---------- labels / groups ---------- */
QLabel {
    color: #e8e8e8;
}
QLabel:disabled {
    color: #777777;
}
QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 8px;
    color: #F7931A;
    font-weight: bold;
    background-color: #161616;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* ---------- checkboxes / radios ---------- */
QCheckBox, QRadioButton {
    color: #e8e8e8;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 17px;
    height: 17px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid #5a5a5a;
    border-radius: 4px;
    background-color: #0d0d0d;
}
QCheckBox::indicator:checked {
    border: 1px solid #F7931A;
    border-radius: 4px;
    background-color: #F7931A;
    image: none;
}
QRadioButton::indicator:unchecked {
    border: 1px solid #5a5a5a;
    border-radius: 9px;
    background-color: #0d0d0d;
}
QRadioButton::indicator:checked {
    border: 1px solid #F7931A;
    border-radius: 9px;
    background-color: #F7931A;
}

/* ---------- progress / sliders / scrollbars ---------- */
QProgressBar {
    background-color: #0d0d0d;
    border: 1px solid #3a3a3a;
    border-radius: 7px;
    text-align: center;
    color: #e8e8e8;
    height: 14px;
}
QProgressBar::chunk {
    background-color: #F7931A;
    border-radius: 6px;
}
QSlider::groove:horizontal {
    height: 6px;
    background-color: #2c2c2c;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background-color: #F7931A;
}
QScrollBar:vertical {
    background-color: #101010;
    width: 13px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #3d3d3d;
    border-radius: 6px;
    min-height: 32px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #F7931A;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background-color: #101010;
    height: 13px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #3d3d3d;
    border-radius: 6px;
    min-width: 32px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #F7931A;
}

/* ---------- status bar / tooltip / splitter ---------- */
QStatusBar {
    background-color: #0d0d0d;
    color: #9a9a9a;
}
QStatusBar::item {
    border: none;
}
QToolTip {
    background-color: #F7931A;
    color: #141414;
    border: none;
    padding: 5px;
    font-weight: bold;
}
QSplitter::handle {
    background-color: #2c2c2c;
}
QSplitter::handle:hover {
    background-color: #F7931A;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #2c2c2c;
}
